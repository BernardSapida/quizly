          "answers": null,
          "position": 17,
          "id": "1830e3be-d9fd-48fe-ad23-35a2e9292490"
        },
        {
          "term": "Unsafe Environment",
          "kind": "standard",
          "definition": "Fire, electrical hazards, or other dangers put the rescuer at risk.",
          "answers": null,
          "position": 18,
          "id": "90dbedf5-caa3-4e93-8b9d-7b8406d55264"
