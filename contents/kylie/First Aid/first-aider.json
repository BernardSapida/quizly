        },
        {
          "id": "0f67aa89-4b85-4db8-aa83-5f2f73d219ff",
          "term": "3 Roles and Responsibilities of a First Aider",
          "kind": "enumeration",
          "definition": "",
          "answers": [
            "Treat each casualty, serious conditions first",
            "Arrange transport to hospital",
            "Stay with casualty until proper care arrives"
          ],
          "position": 8,
          "updatedAt": 1783971504483
        },
        {
          "term": "R.A. 10871",
          "kind": "standard",
          "definition": "Also called the Samboy Lim Law; mandates Basic Life Support training in all schools. Named after Avelino \"Samboy\" Lim, who suffered cardiac arrest in 2014. Section 3 requires all schools to provide BLS training.",
          "answers": null,
          "position": 9,
          "id": "98ad81fd-964e-456b-92df-1da187eb1078"
        },
        {
          "term": "R.A. 10121",
          "kind": "standard",
          "definition": "The Disaster Risk Reduction Act of 2010. Section 4: government plans for disaster preparedness, warning, and response. Section 14: disaster education integrated into the school curriculum.",
          "answers": null,
          "position": 10,
          "id": "ecd8cb45-70e5-4dbd-8b07-293f80248dc5"
        },
        {
          "term": "Article 275",
          "kind": "standard",
          "definition": "Under the Revised Penal Code; punishes abandonment of a person in danger. Penalty: 1 month and 1 day to 6 months imprisonment.",
          "answers": null,
          "position": 11,
          "id": "7ecae4bb-a07d-4b36-b2f7-5ea2d7c9310c"
        },
        {
          "term": "Article 2176",
          "kind": "standard",
          "definition": "Under the Civil Code; establishes liability for quasi-delicts: harm caused by fault or negligence, even without a pre-existing contract.",
          "answers": null,
          "position": 12,
          "id": "d984a9f3-01bd-4790-a5fd-017bc47bfe1d"
        },
        {
