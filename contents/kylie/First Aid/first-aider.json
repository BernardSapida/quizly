      "terms": [
        {
          "term": "First Aider",
          "kind": "standard",
          "definition": "Trained person who gives emergency care, looks after the injured or ill, and keeps them safe from further harm.",
          "answers": null,
          "position": 0,
          "id": "734ed928-3ae6-4086-be0c-2297f63650de"
        },
        {
          "term": "6 Characteristics of a Good First Aider",
          "kind": "enumeration",
          "definition": "",
          "answers": [
            "Gentle",
            "Resourceful",
            "Observant",
            "Tactful",
            "Emphatic",
            "Respectable"
          ],
          "position": 1,
