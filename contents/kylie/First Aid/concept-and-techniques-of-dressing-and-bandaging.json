          "position": 11,
          "id": "cceccdb0-4e85-4f94-9ee1-5a8c523286d1"
        },
        {
          "term": "Binder Bandage",
          "kind": "standard",
          "definition": "Wide bandage; secures dressings over large body parts.",
          "answers": null,
          "position": 12,
          "id": "0c44e8ba-08ed-4e6a-9de2-62ea648ad3d5"
        },
        {
          "term": "General Rules in Bandaging",
          "kind": "standard",
          "definition": "Wash hands before treatment and wear gloves when available; cover wounds with sterile dressings first; apply firm but gentle pressure; do not tie knots over wounds; check circulation after bandaging and ask if the bandage feels too tight; elevate injured limbs when appropriate.",
          "answers": null,
          "position": 13,
