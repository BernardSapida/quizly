        },
        {
          "term": "Triangular Bandage",
          "kind": "standard",
          "definition": "Large triangular cloth; the most versatile; used full or folded into a cravat. Parts: apex, body (base 60 inches), and 2 tips (40 inches each).",
          "answers": null,
          "position": 9,
          "id": "7a974eca-f1ad-43e4-983b-bf116c149a57"
        },
        {
          "term": "Cravat Bandage",
          "kind": "standard",
          "definition": "Made by folding the triangular bandage; available in 1, 2, or 3 folds.",
          "answers": null,
          "position": 10,
          "id": "20ef4468-cd96-4014-86f1-4e09d02f71bd"
        },
        {
          "term": "Roller Bandage",
          "kind": "standard",
          "definition": "Long strip of cloth rolled into a cylinder; provides support and pressure.",
