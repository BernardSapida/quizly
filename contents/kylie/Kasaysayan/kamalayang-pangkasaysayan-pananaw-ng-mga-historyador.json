        },
        {
          "term": "Makabansa",
          "kind": "standard",
          "definition": "May pagmamahal at pagpapahalaga sa bayan; ipinapakita sa pagtangkilik sa lokal na produkto, paggalang sa watawat, at pagsunod sa batas.",
          "answers": null,
          "position": 10,
          "id": "9bee92f1-6a95-4a28-902e-b1a83c70aac4"
        },
        {
          "term": "May Pagkakakilanlan",
          "kind": "standard",
