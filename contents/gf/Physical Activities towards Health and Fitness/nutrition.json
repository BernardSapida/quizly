  "sets": [
    {
      "id": "71fbbf1d-77a7-44f7-8ef9-768bd7d6a912",
      "folderId": "3f7c1a94-5e2b-4d68-9a03-6c1e8b7d2f45",
      "name": "Nutrition",
      "description": "Definition of nutrition, macronutrients and micronutrients, the role of water, and the three eating disorders.",
      "position": 1,
      "updatedAt": 1787286300827,
      "terms": [
        {
          "id": "0b2f26c0-183a-4956-abd1-14c28b7d41ce",
          "term": "Nutrition",
          "kind": "standard",
          "definition": "The study of how the body uses nutrients in food to survive, grow, and maintain health. It refers to the intake of food that meets the nutritional needs of the body. It involves the processes of consuming, absorbing, and utilizing compounds that provide energy and regulate vital bodily functions.",
          "answers": null,
          "updatedAt": 1787286300827,
          "position": 0
        },
        {
          "id": "5961bd10-dfeb-4d40-8cbf-23b078f981da",
          "term": "The 2 Main Categories of Dietary Nutrients",
          "kind": "enumeration",
          "definition": "",
          "answers": [
            "Macronutrients",
            "Micronutrients"
          ],
          "updatedAt": 1787286300827,
          "position": 1
        },
        {
          "id": "06f15a17-b02c-42c1-aa27-869e6003418a",
          "term": "Macronutrients",
          "kind": "standard",
          "definition": "Nutrients the body needs in large quantities to provide energy (measured in calories) and physical building blocks.",
          "answers": null,
          "updatedAt": 1787286300827,
          "position": 2
        },
        {
          "id": "a0d0c870-d6c4-4eae-82ae-4f5e6741e88a",
          "term": "The 3 Macronutrients",
          "kind": "enumeration",
          "definition": "",
          "answers": [
            "Carbohydrates",
            "Proteins",
            "Fats"
          ],
          "updatedAt": 1787286300827,
          "position": 3
        },
        {
          "id": "9a69338e-6be2-4d62-a630-75a4ae5bc4c2",
          "term": "Carbohydrates",
          "kind": "standard",
          "definition": "The body's primary and most readily available source of energy. Found in foods like whole grains, fruits, and vegetables.",
          "answers": null,
          "updatedAt": 1787286300827,
          "position": 4
        },
        {
          "id": "63ee41fb-aa7f-4e09-b225-b85ba6ae3656",
          "term": "Proteins",
          "kind": "standard",
          "definition": "Crucial for building and repairing tissues, hormones, and enzymes. Sourced from meats, poultry, fish, beans, and nuts.",
          "answers": null,
          "updatedAt": 1787286300827,
          "position": 5
        },
        {
          "id": "5ed42294-5d72-44da-8bde-7fd3c3c4331c",
          "term": "Fats",
          "kind": "standard",
          "definition": "Dense sources of sustainable energy that insulate organs, regulate body temperature, and aid in absorbing fat-soluble vitamins.",
          "answers": null,
          "updatedAt": 1787286300827,
          "position": 6
        },
        {
          "id": "d0ae63ae-892a-4f4c-b5c9-5ce3263c49ae",
          "term": "Micronutrients",
          "kind": "standard",
          "definition": "Essential elements required in smaller amounts to protect and promote bodily functions.",
          "answers": null,
          "updatedAt": 1787286300827,
          "position": 7
        },
        {
          "id": "692ab0be-8768-44fa-b931-caeefd205bc3",
          "term": "The 2 Micronutrients",
          "kind": "enumeration",
          "definition": "",
          "answers": [
            "Vitamins",
            "Minerals"
          ],
          "updatedAt": 1787286300827,
          "position": 8
        },
        {
          "id": "03d2a0af-abd4-47e1-8e0a-632f4e0d05c1",
          "term": "Vitamins",
          "kind": "standard",
          "definition": "Organic compounds vital for immunity, energy production, and cellular protection.",
          "answers": null,
          "updatedAt": 1787286300827,
          "position": 9
        },
        {
          "id": "75efa8ee-b744-4287-bd3d-f6951c5a13bb",
          "term": "Minerals",
          "kind": "standard",
          "definition": "Inorganic substances (like calcium, iron, and potassium) that regulate fluid levels, build strong bones, and support muscle/nerve function.",
          "answers": null,
          "updatedAt": 1787286300827,
          "position": 10
        },
        {
          "id": "4e8d8fa7-c359-4c16-9516-56a00d2b4b5e",
          "term": "Water",
          "kind": "standard",
          "definition": "Technically required in macronutrient quantities, it acts as a universal solvent that transports nutrients, regulates temperature, and eliminates waste. Adult men typically average around 60% body water, while adult women average around 50%.",
          "answers": null,
          "updatedAt": 1787286300827,
          "position": 11
        },
        {
          "id": "2ef63330-f57d-4088-92e9-996678a53b61",
          "term": "The 3 Eating Disorders",
          "kind": "enumeration",
          "definition": "",
          "answers": [
            "Anorexia Nervosa",
            "Bulimia Nervosa",
            "Binge-Eating Disorder"
          ],
          "updatedAt": 1787286300827,
          "position": 12
        },
        {
          "id": "84e8544c-a2d8-48cd-bf4c-53dde0189413",
          "term": "Anorexia Nervosa",
          "kind": "standard",
          "definition": "A person will control his or her weight by means of starving himself or herself for fear of being overweight even though he or she is underweight.",
          "answers": null,
          "updatedAt": 1787286300827,
          "position": 13
        },
        {
          "id": "1820da6f-7255-4c80-b0bd-96bec001f07e",
          "term": "Bulimia Nervosa",
          "kind": "standard",
          "definition": "A person will eat a large amount of food and then force to eliminate it from the body by means of vomiting, also called purging.",
          "answers": null,
          "updatedAt": 1787286300827,
          "position": 14
        },
        {
          "id": "9f199f79-04e2-42e2-a66d-857a70e60950",
          "term": "Binge-Eating Disorder",
          "kind": "standard",
          "definition": "This is characterized by compulsive overeating in which a person cannot control how much he or she eats.",
          "answers": null,
          "updatedAt": 1787286300827,
          "position": 15
        }
      ]
    }
  ]
}
