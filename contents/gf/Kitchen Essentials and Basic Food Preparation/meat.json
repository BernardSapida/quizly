          "updatedAt": 1787287766288,
          "position": 42
        },
        {
          "id": "d521c1bc-15d5-48ae-80d6-efdc39482803",
          "term": "Variety Meats",
          "kind": "standard",
          "definition": "Also known as organ and offal. They can be either organ meats or muscle meats. Organ meats are very soft, extremely tender, and easily cooked — examples are liver, kidneys, and brains. Muscle meats require long and slow cooking, as they are heavily exercised muscles and are quite tough — examples include tongue and heart.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 43
        },
        {
          "id": "f28dc5e3-2de6-444c-8d9a-a2450760748c",
          "term": "Processed Meats",
          "kind": "standard",
          "definition": "About one-third of all meat is processed by different methods such as curing, smoking, canning, and drying, meaning it has changed from its original \"fresh\" cut. Examples include ham, sausages, and bacon.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 44
        },
        {
          "id": "1d9a03ac-3dea-40c5-b15b-4169642d2a71",
          "term": "The 3 Common Processed Meats",
          "kind": "enumeration",
          "definition": "",
          "answers": [
            "Ham",
            "Bacon",
            "Sausage"
          ],
          "updatedAt": 1787287766288,
          "position": 45
        },
        {
          "id": "fdc000bb-aced-412a-b8c4-6d1840722402",
          "term": "Ham",
          "kind": "standard",
          "definition": "Cured pork. According to USDA (United States Department of Agriculture) standards, only meat from the hind leg of a hog can be labeled ham.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 46
        },
        {
          "id": "e0727d02-5cea-4c15-8920-ae859e75e2ce",
          "term": "Bacon",
          "kind": "standard",
          "definition": "Cured and smoked meat from the side of a hog.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 47
        },
        {
          "id": "e8129e6d-822a-4952-a5e9-91b4a8fc62e1",
          "term": "Sausage",
          "kind": "standard",
          "definition": "Meat that has been finely chopped or ground and blended with various ingredients, seasonings, and spices. It is then stuffed into casings or skins.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 48
        }
      ]
    }
