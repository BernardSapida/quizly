  "sets": [
    {
      "id": "c98012e2-f8cc-427d-a901-938afad07945",
      "folderId": "d8a80502-bfb9-4590-bc7a-0e8f26d8fb3a",
      "name": "Meat",
      "description": "What meat is, beef and pork classifications, the structure of meat, beef and pork retail cuts and their Filipino names, variety meats, and processed meats.",
      "position": 8,
      "updatedAt": 1787287766288,
      "terms": [
        {
          "id": "940dcb6e-4300-4882-80d4-12720de0179f",
          "term": "Meat",
          "kind": "standard",
          "definition": "One of the most important ingredients in culinary, valued for its rich flavor, nutritional content, and versatility in cooking. It is a primary source of protein, vitamins, and minerals essential for body growth and development. In the kitchen, understanding meat is crucial because its quality, cut, and preparation greatly affect the outcome of a dish. In the Philippines, meat from herbivores such as beef cattle, sheep, goat, and swine serves as the most common source of meat. Meat is generally defined as the muscles of animals, but in a broader sense, it also covers the organs and glands obtained from the animal. Although the word meat includes the flesh of poultry and fish, these are each covered separately.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 0
        },
        {
          "id": "5d38a762-8a66-47eb-8f1d-6156f3a9387f",
          "term": "Beef",
          "kind": "standard",
          "definition": "Originates from cattle that are classified according to age and gender.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 1
        },
        {
          "id": "6cb67c64-e54c-4fdd-89be-454533678d23",
          "term": "The 4 Classifications of Beef Cattle",
          "kind": "enumeration",
          "definition": "",
          "answers": [
            "Steers",
            "Bulls",
            "Heifers and Cows",
            "Calves"
          ],
          "updatedAt": 1787287766288,
          "position": 2
        },
        {
          "id": "03ad555d-ca70-4676-902a-6537cfb3fcc0",
          "term": "Steers",
          "kind": "standard",
          "definition": "Male cattle that are castrated while young so that they will gain weight quickly.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 3
        },
        {
          "id": "ddef90da-5b1f-4694-938e-d69d67335128",
          "term": "Bulls",
          "kind": "standard",
          "definition": "Older, uncastrated male cattle that provide stag meat. Consumers often do not see the tougher meat from bulls, as they are usually used for breeding and then later for processed meats and pet foods.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 4
        },
        {
          "id": "e5cba906-3a3a-467a-a10d-feeef2614b3c",
          "term": "Heifers",
          "kind": "standard",
          "definition": "Female cattle that have not borne a calf; also used for meat.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 5
        },
        {
          "id": "64b78db8-7b49-4ac5-b531-ead5fc69e145",
          "term": "Cows",
          "kind": "standard",
          "definition": "Female cattle that have borne calves. The meat from cows is less desirable than that from steers or heifers.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 6
        },
        {
          "id": "dbaf0baa-fdfa-40e4-9322-5ab567597389",
          "term": "Calves",
          "kind": "standard",
          "definition": "Cattle 3 to 8 months old — too old for veal and too young for beef. If they go to market between 8 and 12 months, their meat is referred to as baby beef.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 7
        },
        {
          "id": "ae267c43-3f71-4cb2-8ed0-ff173ad315ef",
          "term": "Pork",
          "kind": "standard",
          "definition": "Young swine of either gender (male or female) slaughtered between the first 5 1/2 and 7 months of age are the most common source of pork. About 1/3 of all pork is sold fresh, and the rest is made into ham, sausage, luncheon meats, and bacon.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 8
        },
        {
          "id": "14fc0bb2-2f17-45e2-9e18-5ab90fcb25c5",
          "term": "Pigs",
          "kind": "standard",
          "definition": "Technically, swine less than 4 months old.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 9
        },
        {
          "id": "7a5fd3d2-13b9-402f-8765-99695f0e2442",
          "term": "Hogs",
          "kind": "standard",
          "definition": "Technically, swine older than 4 months.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 10
        },
        {
          "id": "2f0dc56e-afd1-45ac-ac1a-2cdced33527f",
          "term": "Structure of Meat",
          "kind": "standard",
          "definition": "Meats are composed of a combination of water, muscle, connective tissue, adipose (fatty) tissue, and often bone.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 11
        },
        {
          "id": "21653e16-c5a0-4874-ad4d-c6556f8b3291",
          "term": "The 4 Components of Meat's Structure",
          "kind": "enumeration",
          "definition": "",
          "answers": [
            "Muscle Tissue",
            "Connective Tissue",
            "Adipose Tissue",
            "Bone"
          ],
          "updatedAt": 1787287766288,
          "position": 12
        },
        {
          "id": "5ea0c20f-16fe-4538-b6af-e14e1fdf1c3d",
          "term": "Muscle Tissue",
          "kind": "standard",
          "definition": "Most of the proteins in meat are found in the muscles. Leaner cuts of muscle tissue yield lesser calories.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 13
        },
        {
          "id": "8a187115-dd94-4a95-8126-9abc4a545984",
          "term": "Connective Tissue",
          "kind": "standard",
          "definition": "Part of ligaments and tendons; it acts as the \"glue\" that holds muscle cells together. The most abundant protein in connective tissue is collagen and elastin. Collagen is tough and fibrous, but converts to a gel when exposed to moist heat.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 14
        },
        {
          "id": "db277720-4e2c-4367-b9d7-6e3b1ccf3be0",
          "term": "Adipose Tissue",
          "kind": "standard",
          "definition": "Simply, fat, which serves as insulation under the skin and as padding for internal organs.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 15
        },
        {
          "id": "3127cf59-50f8-456e-b02e-b7eef00c6ab1",
          "term": "Marbling",
          "kind": "standard",
          "definition": "Fat found within muscles, also called intramuscular fat, deposited in the muscle and seen as little white streaks or drops. Marbling contributes to the flavor and juiciness of meat.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 16
        },
        {
          "id": "9738e827-37a9-420e-a8e8-990c0797c3aa",
          "term": "Bone",
          "kind": "standard",
          "definition": "In meat, bones are used as landmarks for identifying the various meat cuts from a carcass. Older animals have whiter bones; younger animals have reddish bones.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 17
        },
        {
          "id": "1c913cb1-3f43-4c16-9948-f0dd30023b47",
          "term": "Marrow",
          "kind": "standard",
          "definition": "A soft, fatty material in the center of most large bones. Marrow is a valued food in many countries, as it provides much of the flavor in stocks and soups.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 18
        },
        {
          "id": "3cdb89cc-b762-409a-aa92-4211550d0747",
          "term": "Beef Retail Cuts",
          "kind": "standard",
          "definition": "Rib, short loin, and sirloin wholesale cuts lie along the back of the animal and are usually the most tender and expensive cuts of beef. Rib roasts are the most tender roasts, and tenderloin is the most tender steak. The least tender wholesale cuts are flank, short plate, brisket, and foreshank.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 19
        },
        {
          "id": "f1435371-12ed-4efb-a4da-79329ef33676",
          "term": "Filet Mignon",
          "kind": "standard",
          "definition": "The small end of the tenderloin.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 20
        },
        {
          "id": "44035a8e-f085-4a8a-a1ea-1c9b674bc350",
