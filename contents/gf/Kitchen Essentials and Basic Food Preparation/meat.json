          "answers": null,
          "updatedAt": 1787287766288,
          "position": 27
        },
        {
          "id": "f7731648-7da7-4167-8ee6-53a5e7eb550d",
          "term": "Solomilyo",
          "kind": "standard",
          "definition": "The Filipino butchery term for beef tenderloin.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 28
        },
        {
          "id": "b32c374f-9025-482b-be9c-39e246e19639",
          "term": "Paypay",
          "kind": "standard",
          "definition": "The Filipino butchery term for the tender chuck cut of beef.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 29
        },
        {
          "id": "86566535-f068-48a2-8561-25605c25e5ff",
          "term": "Punta y Pecho",
          "kind": "standard",
          "definition": "The Filipino butchery term for beef brisket.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 30
        },
        {
          "id": "01db2ea8-28d7-44ad-b83f-c9b4e7e765c1",
          "term": "Camto",
          "kind": "standard",
          "definition": "The Filipino butchery term for the beef flank steak cut.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 31
        },
        {
          "id": "e95f0597-cf7c-4a21-930b-fd29741865a5",
          "term": "Pork Retail Cuts",
          "kind": "standard",
          "definition": "Pork is usually tender regardless of the cut. Wholesale loin and spare rib cuts of pork are much longer than beef and lamb, because the rib and sirloin are not separated in the carcass. The leg is the largest primal cut in pork; because pork is slaughtered at a young age, pork legs are very tender for roasting.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 32
        },
        {
          "id": "78b82d5d-b96e-4380-8ce3-97abf5399968",
          "term": "The 2 Wholesale Cuts That Provide Most Fresh Pork Retail Cuts",
          "kind": "enumeration",
          "definition": "",
          "answers": [
            "Loin",
            "Spare Rib"
          ],
          "updatedAt": 1787287766288,
          "position": 33
        },
        {
          "id": "aaff4cdd-99a0-4405-a6b7-93187df53475",
          "term": "Loin",
          "kind": "standard",
          "definition": "As a wholesale pork cut, it provides pork loin chop or roast, Canadian-style bacon, and pork loin tenderloin.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 34
        },
        {
          "id": "bef405ba-a523-4987-9258-178edb81f2c4",
          "term": "Spare Rib",
          "kind": "standard",
          "definition": "As a wholesale pork cut, it provides spare ribs, bacon, and rib bacon.",
          "answers": null,
          "updatedAt": 1787287766288,
          "position": 35
        },
        {
