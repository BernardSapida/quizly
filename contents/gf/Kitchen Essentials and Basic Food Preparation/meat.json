          "position": 23
        },
        {
          "id": "abb34a29-8ce8-47ab-becb-90c41bf13b69",
          "term": "Kadera",
          "kind": "standard",
          "definition": "The Filipino butchery term for the beef chuck rib cut.",
          "answers": null,
